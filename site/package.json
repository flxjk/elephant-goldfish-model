{
  "name": "egm-site",
  "private": true,
  "type": "module",
  "description": "Landing site for the Elephant-Goldfish Model, served at https://egm.dev",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "node --test",
    "dev": "npm run astro -- dev",
