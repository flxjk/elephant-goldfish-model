    "preview": "npm run astro -- preview",
    "check": "npm run astro -- check",
    "check:docs": "node scripts/check-docs.mjs",
    "capture": "npm run build && node scripts/capture.mjs",
    "astro": "node scripts/astro.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/starlight": "^0.42.9",
    "@material/web": "2.5.0",
    "astro": "^7.4.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "starlight-llms-txt": "^0.12.0",
    "unified": "^11.0.5",
    "@astrojs/telemetry": "file:./vendor/astro-telemetry"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "puppeteer-core": "25.16.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@astrojs/telemetry": "file:./vendor/astro-telemetry"
  }
